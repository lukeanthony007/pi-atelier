{
	"name": "omp-atelier",
	"version": "0.12.0-omp.1",
	"description": "Pi Atelier's live sidebar and status controls adapted for OMP",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"tui",
		"status-bar"
	],
	"files": [
		"extensions",
		"src",
		"assets/demo.png",
		"assets/preview.png",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"omp": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lukeanthony007/pi-atelier.git"
	},
	"bugs": {
		"url": "https://github.com/lukeanthony007/pi-atelier/issues"
	},
	"homepage": "https://github.com/lukeanthony007/pi-atelier#readme",
	"scripts": {
		"test": "bun --bun ./node_modules/vitest/vitest.mjs run",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check:pack": "node scripts/verify-pack.mjs",
		"check": "npm run typecheck && npm run format:check && npm test && npm run check:pack"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-agent-core": ">=18.1.10",
		"@oh-my-pi/pi-coding-agent": ">=18.1.10",
		"@oh-my-pi/pi-tui": ">=18.1.10",
		"@oh-my-pi/pi-utils": ">=18.1.10"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@oh-my-pi/pi-agent-core": "18.1.10",
		"@oh-my-pi/pi-coding-agent": "18.1.10",
		"@oh-my-pi/pi-tui": "18.1.10",
		"@oh-my-pi/pi-utils": "18.1.10",
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
